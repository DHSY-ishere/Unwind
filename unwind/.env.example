# Copy to .env and fill in. `unwind serve` loads .env automatically.
# Only one of these is needed -- Gemini is tried first.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: S3 audit archiving. Absent = feature off, demo unaffected.
# Point AWS_ENDPOINT_URL at LocalStack (http://localhost:4566) to test free.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_PREFIX=sessions
# AWS_ENDPOINT_URL=http://localhost:4566
